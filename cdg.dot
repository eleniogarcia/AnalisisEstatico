digraph CDG {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", style=filled];
  n0 [label="x := 3", fillcolor=lightblue];
  n1 [label="if (y)", fillcolor=lightyellow];
  n3 [label="y := x + z", fillcolor=lightblue];
  n4 [label="return z", fillcolor=lightcoral];
  n5 [label="EXIT", fillcolor=gray];
  n2 [label="z := x + 1", fillcolor=lightblue];
  n1 -> n2 [style=dashed, color=blue];
  n1 -> n3 [style=dashed, color=blue];
}
