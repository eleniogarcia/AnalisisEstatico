digraph PDG {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", style=filled];
  n8 [label="START", fillcolor=lightgray, shape=ellipse];
  n0 [label="x := 1", fillcolor=lightblue];
  n1 [label="while (x)", fillcolor=lightsalmon];
  n6 [label="return y", fillcolor=lightcoral];
  n7 [label="EXIT", fillcolor=gray];
  n2 [label="if (x)", fillcolor=lightyellow];
  n4 [label="y := 0", fillcolor=lightblue];
  n5 [label="x := y + 1", fillcolor=lightblue];
  n3 [label="y := x + 1", fillcolor=lightblue];

  n1 -> n2 [style=dashed, color=gray, label="ctrl"];
  n1 -> n5 [style=dashed, color=gray, label="ctrl"];
  n1 -> n1 [style=dashed, color=gray, label="ctrl"];
  n2 -> n3 [style=dashed, color=gray, label="ctrl"];
  n2 -> n4 [style=dashed, color=gray, label="ctrl"];
  n8 -> n0 [style=dashed, color=gray, label="ctrl"];
  n8 -> n1 [style=dashed, color=gray, label="ctrl"];
  n8 -> n6 [style=dashed, color=gray, label="ctrl"];
  n8 -> n7 [style=dashed, color=gray, label="ctrl"];
  n5 -> n1 [color=darkgreen, label="x"];
  n0 -> n1 [color=darkgreen, label="x"];
  n3 -> n6 [color=darkgreen, label="y"];
  n4 -> n6 [color=darkgreen, label="y"];
  n5 -> n2 [color=darkgreen, label="x"];
  n0 -> n2 [color=darkgreen, label="x"];
  n3 -> n5 [color=darkgreen, label="y"];
  n4 -> n5 [color=darkgreen, label="y"];
  n5 -> n3 [color=darkgreen, label="x"];
  n0 -> n3 [color=darkgreen, label="x"];
}
